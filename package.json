{
  "name": "map-sdk",
  "version": "3.0.0",
  "description": "A unified map SDK that supports multiple map providers (AMap, Google Maps, OpenLayers, etc.)",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./css": "./dist/index.css"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "map",
    "sdk",
    "amap",
    "google-maps",
    "openlayers",
    "typescript"
  ],
  "author": "yquanmei",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/google.maps": "^3.58.1",
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.38.0",
    "jest": "^29.5.0",
    "rollup": "^4.49.0",
    "rollup-plugin-postcss": "^4.0.2",
    "ts-jest": "^29.1.0",
    "typescript": "^5.9.2"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yquanmei/map-sdk.git"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.10",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@types/lodash-es": "^4.17.12",
    "lodash-es": "^4.17.21"
  }
}
